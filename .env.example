# Dish It runs with zero configuration using bundled seed data.
# Set these only when you want to manage recipes from a Sanity dashboard.

# From `npx sanity@latest init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Used for absolute URLs in metadata, the sitemap, and Open Graph images.
# Optional. Defaults to the Vercel deployment URL pattern.
NEXT_PUBLIC_SITE_URL=https://dish-it.vercel.app
